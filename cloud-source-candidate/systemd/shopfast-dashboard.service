[Unit]
Description=ShopFast Analytics Dashboard
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/shopfast
ExecStart=/home/ubuntu/shopfast/venv/bin/python -u -m uvicorn dashboard_api:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
